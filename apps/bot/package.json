{
  "name": "@scouting/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "commands:deploy": "tsx scripts/deploy-commands.ts",
    "preview": "tsx scripts/preview-post.ts"
  },
  "dependencies": {
    "@scouting/db": "^0.0.0",
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
