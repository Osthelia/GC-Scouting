# Postgres of the site (same database).
DATABASE_URL=postgres://postgres:0@localhost:5432/scouting
# Discord application (Developer Portal > General Information / Bot).
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Only server allowed to host the moderation channel.
MODERATION_GUILD_ID=
# Bearer key of /internal/*, same value as SCOUTING_BOT_KEY on the site.
BOT_INTERNAL_KEY=
APP_URL=http://localhost:3001
# Port of the internal server (health checks and routes called by the site).
PORT=8788
