{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scouting-bot",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bfeb715893084155892358c428574ada",
      // `wrangler dev` connects here instead.
      "localConnectionString": "postgres://scouting_app:d0d8d69ec654108bd90e2687e5813b34abf49897819313543ba4247f1dd07302@localhost:15432/scouting"
    }
  ],
  // Catch up on posts the site could not hand over (bot down, failed call).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Secrets (wrangler secret put): DISCORD_APPLICATION_ID, DISCORD_PUBLIC_KEY, DISCORD_BOT_TOKEN, MODERATION_GUILD_ID, BOT_INTERNAL_KEY.
  "vars": {
    "APP_URL": "https://scouting.gc-stats.app",
    "KASM_TWEETS_URL": "https://kasm.osthelia.org/#/cast/tweet?kasm_url=http%3A%2F%2F172.30.50.10%2Ftweets"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
