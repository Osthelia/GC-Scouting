DATABASE_URL=postgres://postgres:0@localhost:5432/scouting
# Connections per process (replicas times this must stay under what PgBouncer accepts).
DATABASE_POOL_SIZE=10

# Public URL of the site, used for the OAuth redirect URI (falls back to the request origin).
APP_URL=http://localhost:3001
# GC Stats instance (local GC Stats in dev).
NEXT_PUBLIC_GCS_URL=https://gc-stats.app
# OAuth client "Scouting" registered in the GC Stats admin (redirect URI: {APP_URL}/api/auth/callback).
GCS_OAUTH_CLIENT_ID=
GCS_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=
# GC Stats public API key (history snapshot of posts, profile link assistant).
GCS_API_KEY=
# Bearer secret of the cron endpoints (/api/cron/*).
CRON_SECRET=
# Expiry reminder emails (Resend). Sender defaults to "GC Scouting <notifications@gc-stats.app>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Expiry reminder DMs, key registered as "scouting" in SERVICE_KEYS of the DiscordNotificationsWorker.
DISCORD_NOTIFICATIONS_WORKER_KEY=
# Base URL of the DiscordNotificationsWorker.
DISCORD_NOTIFICATIONS_WORKER_URL=
# Scouting bot (apps/bot): same value as its BOT_INTERNAL_KEY.
SCOUTING_BOT_KEY=
# Base URL of the bot internal server (apps/bot).
SCOUTING_BOT_URL=http://localhost:8788

# Community links (Discord bot invite, X account), hidden while empty.
DISCORD_BOT_INVITE_URL=
TWITTER_URL=

# Automod of the chat (OpenAI Moderation API, free). Empty: messages go through unchecked.
OPENAI_API_KEY=
# GC Stats user ids (OAuth sub, comma separated) always admin of the site, to give the first roles.
ADMIN_GCS_USER_IDS=

# Object storage (S3 compatible) for the stored share images. Left empty, the images are rendered on each request.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
